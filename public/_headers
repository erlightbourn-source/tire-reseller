# Cloudflare Workers static assets (/_next/static, /sw.js, images, robots) never
# pass through middleware.js or next.config headers(), so they get their security
# headers here (audit L1624). Pages keep theirs from next.config.mjs.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
